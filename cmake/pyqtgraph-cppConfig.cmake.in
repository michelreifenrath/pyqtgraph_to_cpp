@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_pyqtgraph_cpp_qt_components "@PYQTGRAPH_CPP_PACKAGE_QT_COMPONENTS@")
if(_pyqtgraph_cpp_qt_components)
    find_dependency(Qt6 6 COMPONENTS ${_pyqtgraph_cpp_qt_components})
endif()
unset(_pyqtgraph_cpp_qt_components)

include("${CMAKE_CURRENT_LIST_DIR}/pyqtgraph-cppTargets.cmake")
