@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(_cppqtgraph_qt_components "@CPPQTGRAPH_PACKAGE_QT_COMPONENTS@")
if(_cppqtgraph_qt_components)
    find_dependency(Qt6 6 COMPONENTS ${_cppqtgraph_qt_components})
endif()
unset(_cppqtgraph_qt_components)

if(@CPPQTGRAPH_PACKAGE_REQUIRE_OPENCV@)
    find_dependency(OpenCV 4)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/CppQtGraphTargets.cmake")
