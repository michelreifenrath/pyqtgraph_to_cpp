#!/usr/bin/env python3
"""Verify branch changes stay inside the active issue ownership claim."""

from __future__ import annotations

import argparse
import fnmatch
import os
import posixpath
import re
import subprocess
import sys
from pathlib import Path, PureWindowsPath
from typing import Any, TextIO

import yaml

REPO_ROOT = Path(__file__).resolve().parents[1]
DEFAULT_REGISTRY = REPO_ROOT / "ownership.yaml"
DEFAULT_WORKFLOW = REPO_ROOT / "WORKFLOW.md"
ISSUE_CODE_RE = re.compile(r"^P\d+\.\d+$")

ADJUNCT_PATTERNS = {
    "focused-doc-report": ["reports/issues/<issue-code>/**"],
}


class OwnershipBoundaryError(ValueError):
    """Raised when ownership metadata or changed files are invalid."""


def normalize_repo_path(value: str) -> str:
    path = value.strip().replace("\\", "/")
    if not path:
        raise OwnershipBoundaryError("paths must not be empty")
    normalized = posixpath.normpath(path)
    if posixpath.isabs(normalized) or PureWindowsPath(path).is_absolute():
        raise OwnershipBoundaryError("paths must be relative to repository root")
    if normalized == ".":
        raise OwnershipBoundaryError("paths must not be empty")
    if normalized == ".." or normalized.startswith("../"):
        raise OwnershipBoundaryError("paths must not escape repository root")
    return normalized


def normalize_pattern(value: str) -> str:
    path = value.strip().replace("\\", "/")
    if not path:
        raise OwnershipBoundaryError("owned file patterns must not be empty")
    if posixpath.isabs(path) or PureWindowsPath(path).is_absolute():
        raise OwnershipBoundaryError("owned file patterns must be relative to repository root")
    if path == ".." or path.startswith("../"):
        raise OwnershipBoundaryError("owned file patterns must not escape repository root")
    return path


def path_is_allowed(path: str, patterns: list[str]) -> bool:
    normalized = normalize_repo_path(path)
    return any(fnmatch.fnmatchcase(normalized, pattern) for pattern in patterns)


def load_registry_from_stream(registry_file: TextIO) -> dict[str, Any]:
    data = yaml.safe_load(registry_file)
    if not isinstance(data, dict):
        raise OwnershipBoundaryError("registry must be a YAML mapping")
    if data.get("version") != 1:
        raise OwnershipBoundaryError("registry version must be 1")
    claims = data.get("claims")
    if not isinstance(claims, list):
        raise OwnershipBoundaryError("registry claims must be a list")
    for index, claim in enumerate(claims):
        validate_claim(claim, index)
    return data


def load_registry(path: Path) -> dict[str, Any]:
    if not path.exists():
        raise OwnershipBoundaryError(f"missing ownership registry: {path}")
    with path.open("r", encoding="utf-8") as registry_file:
        return load_registry_from_stream(registry_file)


def validate_claim(claim: Any, index: int) -> None:
    if not isinstance(claim, dict):
        raise OwnershipBoundaryError(f"claim {index} must be a mapping")
    for key in ("issue", "branch", "status"):
        if not isinstance(claim.get(key), str) or not claim[key].strip():
            raise OwnershipBoundaryError(f"claim {index} must have a non-empty {key}")
    if not ISSUE_CODE_RE.fullmatch(claim["issue"].strip()):
        raise OwnershipBoundaryError(f"claim {index} issue must be a local issue id like P0.05")
    owned_files = claim.get("owned_files")
    if not isinstance(owned_files, list) or not owned_files:
        raise OwnershipBoundaryError(f"claim {index} owned_files must be a non-empty list")
    for owned_file in owned_files:
        if not isinstance(owned_file, str):
            raise OwnershipBoundaryError(f"claim {index} owned_files entries must be strings")
        normalize_pattern(owned_file)
    adjuncts = claim.get("adjuncts", [])
    if adjuncts is None:
        adjuncts = []
    if not isinstance(adjuncts, list):
        raise OwnershipBoundaryError(f"claim {index} adjuncts must be a list")
    for adjunct in adjuncts:
        if not isinstance(adjunct, str) or adjunct not in ADJUNCT_PATTERNS:
            raise OwnershipBoundaryError(
                f"claim {index} adjunct {adjunct!r} is unknown; known adjuncts: "
                + ", ".join(sorted(ADJUNCT_PATTERNS))
            )


def find_active_claim(claims: list[dict[str, Any]], branch: str) -> dict[str, Any] | None:
    matches = [claim for claim in claims if claim.get("status") == "active" and claim.get("branch") == branch]
    if not matches:
        return None
    if len(matches) > 1:
        issues = ", ".join(sorted(str(claim.get("issue", "")) for claim in matches))
        raise OwnershipBoundaryError(
            f"inconsistent ownership metadata: branch {branch} has multiple active claims: {issues}"
        )
    return matches[0]


def _split_front_matter(text: str) -> str:
    if not text.startswith("---\n"):
        raise OwnershipBoundaryError("WORKFLOW.md must start with YAML front matter")
    try:
        _prefix, front_matter, _body = text.split("---", 2)
    except ValueError as error:
        raise OwnershipBoundaryError("WORKFLOW.md front matter is not closed") from error
    return front_matter.strip()


def load_shared_integration_patterns(workflow_path: Path, issue_code: str) -> list[str]:
    if not workflow_path.is_file():
        raise OwnershipBoundaryError(f"missing workflow file: {workflow_path}")
    try:
        loaded = yaml.safe_load(_split_front_matter(workflow_path.read_text(encoding="utf-8"))) or {}
    except yaml.YAMLError as exc:
        raise OwnershipBoundaryError(f"failed to parse workflow file: {exc}") from exc
    if not isinstance(loaded, dict):
        raise OwnershipBoundaryError("workflow front matter must be a mapping")
    policy = loaded.get("policy", {})
    if policy is None:
        policy = {}
    if not isinstance(policy, dict):
        raise OwnershipBoundaryError("workflow policy must be a mapping")
    shared_files = policy.get("shared_integration_files", [])
    if shared_files is None:
        shared_files = []
    if not isinstance(shared_files, list):
        raise OwnershipBoundaryError("policy.shared_integration_files must be a list")
    patterns: list[str] = []
    for entry in shared_files:
        if not isinstance(entry, str) or not entry.strip():
            raise OwnershipBoundaryError("shared_integration_files entries must be non-empty strings")
        patterns.append(entry.replace("<issue-code>", issue_code))
    return patterns


def expand_adjunct_patterns(adjuncts: list[str], issue_code: str) -> list[str]:
    patterns: list[str] = []
    for adjunct in adjuncts:
        for pattern in ADJUNCT_PATTERNS[adjunct]:
            patterns.append(pattern.replace("<issue-code>", issue_code))
    return patterns


def collect_allowed_patterns(claim: dict[str, Any], *, workflow_path: Path) -> list[str]:
    issue_code = claim["issue"].strip()
    patterns = [normalize_pattern(path) for path in claim["owned_files"]]
    patterns.extend(expand_adjunct_patterns(claim.get("adjuncts", []) or [], issue_code))
    patterns.extend(load_shared_integration_patterns(workflow_path, issue_code))
    return list(dict.fromkeys(patterns))


def check_changed_files(changed_files: list[str], patterns: list[str]) -> list[str]:
    violations: list[str] = []
    for changed_file in changed_files:
        normalized = changed_file.strip()
        if not normalized:
            continue
        if not path_is_allowed(normalized, patterns):
            violations.append(normalized)
    return violations


def git_current_branch(repo_root: Path) -> str:
    result = subprocess.run(
        ["git", "rev-parse", "--abbrev-ref", "HEAD"],
        cwd=repo_root,
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        raise OwnershipBoundaryError("could not determine current git branch")
    branch = result.stdout.strip()
    if not branch:
        raise OwnershipBoundaryError("could not determine current git branch")
    return branch


def git_changed_files(repo_root: Path, base: str) -> list[str]:
    result = subprocess.run(
        ["git", "diff", "--name-only", f"{base}...HEAD"],
        cwd=repo_root,
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        raise OwnershipBoundaryError(f"git diff failed for {base}...HEAD: {result.stderr.strip()}")
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def run_check(
    *,
    repo_root: Path,
    registry_path: Path,
    workflow_path: Path,
    base: str,
    branch: str | None = None,
    changed_files: list[str] | None = None,
) -> int:
    try:
        registry = load_registry(registry_path)
        resolved_branch = branch or git_current_branch(repo_root)
        claim = find_active_claim(registry["claims"], resolved_branch)
        if claim is None:
            raise OwnershipBoundaryError(
                f"missing active ownership claim for branch {resolved_branch}"
            )
        patterns = collect_allowed_patterns(claim, workflow_path=workflow_path)
        paths = changed_files if changed_files is not None else git_changed_files(repo_root, base)
        violations = check_changed_files(paths, patterns)
    except OwnershipBoundaryError as error:
        print(f"changed-file ownership check failed: {error}", file=sys.stderr)
        return 1

    if violations:
        print("changed-file ownership check failed:", file=sys.stderr)
        for path in violations:
            print(f"- out-of-scope changed file: {path}", file=sys.stderr)
        return 1

    print("changed-file ownership check passed")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Verify changed files stay inside the active issue ownership claim."
    )
    parser.add_argument(
        "--registry",
        type=Path,
        default=DEFAULT_REGISTRY,
        help="path to ownership registry YAML (default: repo ownership.yaml)",
    )
    parser.add_argument(
        "--workflow",
        type=Path,
        default=DEFAULT_WORKFLOW,
        help="path to WORKFLOW.md for shared integration allowlist",
    )
    parser.add_argument(
        "--base",
        default="origin/main",
        help="git base ref for branch changed-file discovery",
    )
    parser.add_argument(
        "--branch",
        help="branch name to resolve the active claim (default: current git branch)",
    )
    parser.add_argument(
        "--changed-file",
        action="append",
        default=None,
        dest="changed_files",
        help="explicit changed file path; repeat to bypass git diff discovery",
    )
    parser.add_argument(
        "--repo-root",
        type=Path,
        default=REPO_ROOT,
        help="repository root for git commands",
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    registry_path = args.registry
    if not registry_path.is_absolute():
        registry_path = args.repo_root / registry_path
    workflow_path = args.workflow
    if not workflow_path.is_absolute():
        workflow_path = args.repo_root / workflow_path
    return run_check(
        repo_root=args.repo_root,
        registry_path=registry_path,
        workflow_path=workflow_path,
        base=args.base,
        branch=args.branch,
        changed_files=args.changed_files,
    )


if __name__ == "__main__":
    raise SystemExit(main())
