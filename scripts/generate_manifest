#!/usr/bin/env python3
"""Generate and validate the repository-level PyQtGraph port manifest."""

from __future__ import annotations

import argparse
import importlib.util
import json
import sys
from pathlib import Path
from typing import Any

import yaml

SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parent
ORACLE_SCRIPT_DIR = REPO_ROOT / "oracle" / "scripts"
MANIFEST_PATH = Path("port_manifest.yaml")
MANIFEST_SCHEMA_KEY = "manifest_schema"
CURRENT_MANIFEST_SCHEMA = {"status_metadata": "evidence_backed"}
GENERATED_MANIFEST_KEYS = (
    "reference",
    MANIFEST_SCHEMA_KEY,
    "source_files",
    "examples",
    "example_assets",
    "example_inventory_summary",
    "classes",
    "excluded",
    "summary",
)
MANIFEST_REFERENCE_KEYS = ("repo", "ref", "pinned_commit", "docs_url")
TARGET_PATH_KEYS = ("target_header_path", "target_source_path", "target_path")
STATUS_METADATA_SECTIONS = ("source_files", "examples", "example_assets", "classes")
STATUS_METADATA_KEYS = ("status", "completion", "target_presence")
COMPLETION_EVIDENCE_KEY = "completion_evidence"
COMPLETION_EVIDENCE_TYPES = {
    "focused_test",
    "numeric_oracle",
    "visual_proof",
    "interaction_proof",
    "completion_report",
    "approved_equivalence",
}
STATUS_BY_PRESENT_COUNT = {
    "all": "ported",
    "some": "partial",
    "none": "not_started",
}


class ManifestError(RuntimeError):
    """Raised when manifest generation cannot be completed safely."""


def load_oracle_module(name: str, filename: str) -> Any:
    module_path = ORACLE_SCRIPT_DIR / filename
    spec = importlib.util.spec_from_file_location(name, module_path)
    if spec is None or spec.loader is None:
        raise ManifestError(f"could not load oracle script: {module_path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


source_inventory = load_oracle_module(
    "pginv_source_inventory", "generate_source_inventory.py"
)
example_inventory = load_oracle_module(
    "pginv_example_inventory", "generate_example_manifest.py"
)
class_inventory = load_oracle_module("pginv_class_inventory", "generate_class_inventory.py")
InventoryError = source_inventory.InventoryError


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Generate the deterministic PyQtGraph port manifest."
    )
    parser.add_argument(
        "--root",
        type=Path,
        default=Path.cwd(),
        help="repository root containing reference/source.lock",
    )
    parser.add_argument(
        "--format",
        choices=("yaml", "json"),
        default="yaml",
        help="manifest serialization format for stdout",
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--check",
        action="store_true",
        help="validate port_manifest.yaml without writing persistent files",
    )
    mode.add_argument(
        "--update-manifest",
        action="store_true",
        help="update generated sections in port_manifest.yaml",
    )
    return parser.parse_args(argv)


def row_identity(section: str, row: dict[str, Any]) -> tuple[str, str, str | None]:
    return (section, str(row.get("upstream_path", "")), row.get("class_name"))


def validate_evidence_artifact(root: Path, prefix: str, value: Any) -> str:
    if not isinstance(value, str) or not value:
        raise ManifestError(f"{prefix}.artifact_path must be a non-empty string")
    relative_path = Path(value)
    if relative_path.is_absolute():
        raise ManifestError(f"{prefix}.artifact_path must be relative: {value}")
    root_path = root.resolve()
    artifact_path = (root_path / relative_path).resolve()
    if not artifact_path.is_relative_to(root_path):
        raise ManifestError(f"{prefix}.artifact_path escapes repository root: {value}")
    if not artifact_path.is_file():
        raise ManifestError(f"{prefix}.artifact_path missing: {value}")
    return value


def parse_completion_evidence(
    root: Path, records: Any
) -> dict[tuple[str, str, str | None], dict[str, str]]:
    if records is None:
        return {}
    if not isinstance(records, list):
        raise ManifestError(f"{COMPLETION_EVIDENCE_KEY} must be a list")

    parsed: dict[tuple[str, str, str | None], dict[str, str]] = {}
    for index, record in enumerate(records):
        prefix = f"{COMPLETION_EVIDENCE_KEY}[{index}]"
        if not isinstance(record, dict):
            raise ManifestError(f"{prefix} must be a mapping")
        section = record.get("section")
        upstream_path = record.get("upstream_path")
        class_name = record.get("class_name")
        evidence_type = record.get("evidence_type")
        if section not in STATUS_METADATA_SECTIONS:
            raise ManifestError(f"{prefix}.section is invalid: {section}")
        if not isinstance(upstream_path, str) or not upstream_path:
            raise ManifestError(f"{prefix}.upstream_path must be a non-empty string")
        if section == "classes":
            if not isinstance(class_name, str) or not class_name:
                raise ManifestError(f"{prefix}.class_name must be a non-empty string")
        elif class_name is not None:
            raise ManifestError(f"{prefix}.class_name is only valid for classes")
        if evidence_type not in COMPLETION_EVIDENCE_TYPES:
            raise ManifestError(f"{prefix}.evidence_type is invalid: {evidence_type}")
        artifact_path = validate_evidence_artifact(root, prefix, record.get("artifact_path"))
        key = (section, upstream_path, class_name)
        if key in parsed:
            raise ManifestError(f"duplicate {COMPLETION_EVIDENCE_KEY} record: {key}")
        parsed[key] = {"type": evidence_type, "artifact_path": artifact_path}
    return parsed


def load_completion_evidence(root: Path) -> dict[tuple[str, str, str | None], dict[str, str]]:
    existing = load_existing_manifest(root / MANIFEST_PATH)
    return parse_completion_evidence(root, existing.get(COMPLETION_EVIDENCE_KEY))


def row_status(
    root: Path,
    section: str,
    row: dict[str, Any],
    evidence: dict[tuple[str, str, str | None], dict[str, str]],
) -> dict[str, Any]:
    target_paths = [row[key] for key in TARGET_PATH_KEYS if key in row]
    present_count = sum(1 for path in target_paths if (root / path).exists())
    if target_paths and present_count == len(target_paths):
        target_presence = "all"
    elif present_count == 0:
        target_presence = "none"
    else:
        target_presence = "some"

    metadata: dict[str, Any] = {
        "status": STATUS_BY_PRESENT_COUNT[target_presence],
        "completion": "missing",
        "target_presence": target_presence,
    }
    row_evidence = evidence.get(row_identity(section, row))
    if row_evidence is not None:
        if target_presence != "all":
            raise ManifestError(
                f"{COMPLETION_EVIDENCE_KEY} references row without all target files: "
                f"{section} {row.get('upstream_path')}"
            )
        metadata["completion"] = "complete"
        metadata[COMPLETION_EVIDENCE_KEY] = row_evidence
    return metadata


def with_completion_metadata(
    root: Path,
    section: str,
    rows: list[dict[str, Any]],
    evidence: dict[tuple[str, str, str | None], dict[str, str]],
) -> list[dict[str, Any]]:
    return [{**row, **row_status(root, section, row, evidence)} for row in rows]


def validate_completion_evidence_matches_manifest(
    generated: dict[str, Any],
    evidence: dict[tuple[str, str, str | None], dict[str, str]],
) -> None:
    if not evidence:
        return
    generated_keys: set[tuple[str, str, str | None]] = set()
    for section in STATUS_METADATA_SECTIONS:
        rows = generated.get(section, [])
        if not isinstance(rows, list):
            continue
        for row in rows:
            if isinstance(row, dict):
                generated_keys.add(row_identity(section, row))

    unknown_keys = sorted(evidence.keys() - generated_keys)
    if unknown_keys:
        section, upstream_path, class_name = unknown_keys[0]
        class_suffix = f" class_name={class_name}" if class_name is not None else ""
        raise ManifestError(
            f"{COMPLETION_EVIDENCE_KEY} references unknown manifest row: "
            f"section={section} upstream_path={upstream_path}{class_suffix}"
        )


def validate_generated_status_metadata(generated: dict[str, Any]) -> None:
    missing = []
    for section in STATUS_METADATA_SECTIONS:
        for index, row in enumerate(generated[section]):
            if any(key not in row for key in STATUS_METADATA_KEYS):
                missing.append(f"{section}[{index}]")
    if missing:
        raise ManifestError(
            "generated status/completion metadata missing from row(s): "
            + ", ".join(missing)
        )


def build_manifest(root: Path) -> dict[str, Any]:
    completion_evidence = load_completion_evidence(root)
    lock = source_inventory.load_lock(root)
    with source_inventory.source_checkout(root, lock) as checkout:
        source = source_inventory.enumerate_inventory(checkout, lock)
        examples = example_inventory.enumerate_inventory(checkout, lock)
        classes = class_inventory.enumerate_inventory(checkout, lock)

    if source["reference"] != examples["reference"] or source["reference"] != classes["reference"]:
        raise ManifestError("inventory reference metadata disagree")
    if source["excluded"] != classes["excluded"]:
        raise ManifestError("source and class inventory exclusions disagree")

    example_summary = examples["summary"]
    generated = {
        "reference": {
            key: source["reference"][key] for key in MANIFEST_REFERENCE_KEYS
        },
        MANIFEST_SCHEMA_KEY: dict(CURRENT_MANIFEST_SCHEMA),
        "source_files": with_completion_metadata(
            root, "source_files", source["source_files"], completion_evidence
        ),
        "examples": with_completion_metadata(
            root, "examples", examples["examples"], completion_evidence
        ),
        "example_assets": with_completion_metadata(
            root, "example_assets", examples["assets"], completion_evidence
        ),
        "example_inventory_summary": example_summary,
        "classes": with_completion_metadata(
            root, "classes", classes["classes"], completion_evidence
        ),
        "excluded": source["excluded"],
        "summary": {
            "source_file_count": len(source["source_files"]),
            "example_count": example_summary["example_count"],
            "example_asset_count": example_summary["asset_count"],
            "total_example_tree_file_count": example_summary[
                "total_example_tree_file_count"
            ],
            "class_count": len(classes["classes"]),
            "excluded_example_count": len(source["excluded"]["examples"]),
            "excluded_test_count": len(source["excluded"]["tests"]),
        },
    }
    validate_completion_evidence_matches_manifest(generated, completion_evidence)
    validate_generated_status_metadata(generated)
    return generated


def render_manifest(manifest: dict[str, Any], output_format: str) -> str:
    if output_format == "json":
        return json.dumps(manifest, indent=2, sort_keys=False) + "\n"
    return yaml.safe_dump(manifest, sort_keys=False)


def load_existing_manifest(manifest_path: Path) -> dict[str, Any]:
    if not manifest_path.exists():
        return {}
    data = yaml.safe_load(manifest_path.read_text(encoding="utf-8"))
    if data is None:
        return {}
    if not isinstance(data, dict):
        raise ManifestError("port_manifest.yaml must contain a YAML mapping")
    return data


def merged_manifest(existing: dict[str, Any], generated: dict[str, Any]) -> dict[str, Any]:
    merged = {key: generated[key] for key in GENERATED_MANIFEST_KEYS}
    for key, value in existing.items():
        if key not in GENERATED_MANIFEST_KEYS:
            merged[key] = value
    return merged


def update_manifest(root: Path, generated: dict[str, Any]) -> None:
    manifest_path = root / MANIFEST_PATH
    existing = load_existing_manifest(manifest_path)
    manifest_path.write_text(
        yaml.safe_dump(merged_manifest(existing, generated), sort_keys=False),
        encoding="utf-8",
    )


def validate_manifest_current(root: Path, generated: dict[str, Any]) -> None:
    manifest_path = root / MANIFEST_PATH
    if not manifest_path.exists():
        raise ManifestError(
            "port_manifest.yaml is missing; run --update-manifest to create it"
        )
    validate_generated_status_metadata(generated)
    existing = load_existing_manifest(manifest_path)
    stale_keys = [
        key for key in GENERATED_MANIFEST_KEYS if existing.get(key) != generated[key]
    ]
    if stale_keys:
        metadata_stale = any(
            key in (MANIFEST_SCHEMA_KEY, *STATUS_METADATA_SECTIONS)
            for key in stale_keys
        )
        metadata_note = ""
        if metadata_stale:
            metadata_note = " (status/completion metadata missing or stale)"
        raise ManifestError(
            "port_manifest.yaml is stale; run --update-manifest "
            "to refresh generated section(s)"
            + metadata_note
            + ": "
            + ", ".join(stale_keys)
        )


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    root = args.root.resolve()

    try:
        manifest = build_manifest(root)
        if args.check:
            render_manifest(manifest, args.format)
            validate_manifest_current(root, manifest)
            print(
                "port manifest verified "
                f"({manifest['summary']['source_file_count']} source files, "
                f"{manifest['summary']['example_count']} examples, "
                f"{manifest['summary']['class_count']} classes)"
            )
        elif args.update_manifest:
            update_manifest(root, manifest)
            print("updated port_manifest.yaml")
        else:
            sys.stdout.write(render_manifest(manifest, args.format))
        return 0
    except (InventoryError, ManifestError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
