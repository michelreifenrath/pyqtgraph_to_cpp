#!/usr/bin/env python3
"""Claim an issue's owned files in the ownership registry."""

from __future__ import annotations

import argparse
import fcntl
import os
import posixpath
import sys
import tempfile
from pathlib import Path, PureWindowsPath
from typing import Any, TextIO

import yaml


DEFAULT_REGISTRY = Path(__file__).resolve().parents[1] / "ownership.yaml"
INITIAL_REGISTRY = {"version": 1, "claims": []}


class RegistryError(ValueError):
    """Raised when the ownership registry is malformed."""


def empty_registry() -> dict[str, Any]:
    return {"version": INITIAL_REGISTRY["version"], "claims": []}


def normalize_owned_file(value: str) -> str:
    path = value.strip().replace("\\", "/")
    if not path:
        raise RegistryError("owned file paths must not be empty")
    normalized = posixpath.normpath(path)
    if posixpath.isabs(normalized) or PureWindowsPath(path).is_absolute():
        raise RegistryError("owned file paths must be relative to repository root")
    if normalized == ".":
        raise RegistryError("owned file paths must not be empty")
    if normalized == ".." or normalized.startswith("../"):
        raise RegistryError("owned file paths must not escape repository root")
    return normalized


def non_empty_arg(value: str) -> str:
    if not value.strip():
        raise argparse.ArgumentTypeError("must be non-empty")
    return value


def load_registry(path: Path) -> dict[str, Any]:
    if not path.exists():
        return empty_registry()

    with path.open("r", encoding="utf-8") as registry_file:
        return load_registry_from_stream(registry_file)


def load_registry_from_stream(registry_file: TextIO) -> dict[str, Any]:
    data = yaml.safe_load(registry_file)
    if not isinstance(data, dict):
        raise RegistryError("registry must be a YAML mapping")
    if data.get("version") != 1:
        raise RegistryError("registry version must be 1")
    claims = data.get("claims")
    if not isinstance(claims, list):
        raise RegistryError("registry claims must be a list")

    for index, claim in enumerate(claims):
        validate_claim(claim, index)

    return data


def validate_claim(claim: Any, index: int) -> None:
    if not isinstance(claim, dict):
        raise RegistryError(f"claim {index} must be a mapping")
    for key in ("issue", "branch", "status"):
        if not isinstance(claim.get(key), str) or not claim[key].strip():
            raise RegistryError(f"claim {index} must have a non-empty {key}")
    owned_files = claim.get("owned_files")
    if not isinstance(owned_files, list):
        raise RegistryError(f"claim {index} owned_files must be a list")
    for owned_file in owned_files:
        if not isinstance(owned_file, str):
            raise RegistryError(f"claim {index} owned_files entries must be strings")
        normalize_owned_file(owned_file)
    adjuncts = claim.get("adjuncts", [])
    if adjuncts is None:
        adjuncts = []
    if not isinstance(adjuncts, list):
        raise RegistryError(f"claim {index} adjuncts must be a list")
    for adjunct in adjuncts:
        if not isinstance(adjunct, str) or not adjunct.strip():
            raise RegistryError(f"claim {index} adjuncts entries must be non-empty strings")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Record a non-overlapping active issue claim in ownership.yaml."
    )
    parser.add_argument(
        "--registry",
        type=Path,
        default=DEFAULT_REGISTRY,
        help="path to ownership registry YAML (default: repo ownership.yaml)",
    )
    parser.add_argument(
        "--issue",
        required=True,
        type=non_empty_arg,
        help="issue id to claim, e.g. PGBOOT-004",
    )
    parser.add_argument(
        "--branch",
        required=True,
        type=non_empty_arg,
        help="branch name for the claim",
    )
    parser.add_argument(
        "--file",
        dest="owned_files",
        action="append",
        required=True,
        help="owned file path for the claim; repeat for multiple files",
    )
    return parser


def find_conflict(
    requested_files: set[str], claims: list[dict[str, Any]]
) -> tuple[str, dict[str, Any]] | None:
    for claim in claims:
        if claim["status"] != "active":
            continue
        for owned_file in claim["owned_files"]:
            normalized = normalize_owned_file(owned_file)
            if normalized in requested_files:
                return normalized, claim
    return None


def write_registry(path: Path, registry: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary_path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            "w",
            dir=path.parent,
            encoding="utf-8",
            prefix=f".{path.name}.",
            suffix=".tmp",
            delete=False,
        ) as registry_file:
            temporary_path = Path(registry_file.name)
            yaml.safe_dump(registry, registry_file, sort_keys=False)
            registry_file.flush()
            os.fsync(registry_file.fileno())
        os.replace(temporary_path, path)
    finally:
        if temporary_path is not None:
            try:
                temporary_path.unlink()
            except FileNotFoundError:
                pass


def record_claim(
    path: Path, issue: str, branch: str, requested_files: list[str]
) -> tuple[str, dict[str, Any]] | None:
    path.parent.mkdir(parents=True, exist_ok=True)
    lock_fd = os.open(path.parent, os.O_RDONLY)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        registry = load_registry(path)
        conflict = find_conflict(set(requested_files), registry["claims"])
        if conflict is not None:
            return conflict

        registry["claims"].append(
            {
                "issue": issue,
                "branch": branch,
                "status": "active",
                "owned_files": requested_files,
            }
        )
        write_registry(path, registry)
        os.fsync(lock_fd)
        return None
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)
        os.close(lock_fd)


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    try:
        requested_files = [normalize_owned_file(path) for path in args.owned_files]
        conflict = record_claim(args.registry, args.issue, args.branch, requested_files)
    except RegistryError as error:
        print(f"claim rejected: {error}", file=sys.stderr)
        return 1
    except yaml.YAMLError as error:
        print(f"claim rejected: could not parse registry YAML: {error}", file=sys.stderr)
        return 1

    if conflict is not None:
        owned_file, claim = conflict
        print(
            f"claim rejected: {owned_file} overlaps active claim "
            f"{claim['issue']} on branch {claim['branch']}",
            file=sys.stderr,
        )
        return 1

    print(f"claim recorded: {args.issue} owns {len(requested_files)} file(s)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
