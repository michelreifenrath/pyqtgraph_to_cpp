#!/usr/bin/env python3
"""Run validation for local examples changed on this branch."""

from __future__ import annotations

import argparse
import os
import re
import shlex
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any

try:
    import yaml
except Exception:  # pragma: no cover - reported when the manifest is loaded
    yaml = None


@dataclass(frozen=True)
class Example:
    name: str
    target_path: str
    ctest_name: str
    aliases: tuple[str, ...]
    visual_required: bool = False
    visual_ctest_name: str | None = None


class ManifestError(RuntimeError):
    pass


def repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def parser() -> argparse.ArgumentParser:
    argument_parser = argparse.ArgumentParser(
        description="Run CTest for local examples changed relative to a base ref."
    )
    argument_parser.add_argument(
        "selections",
        nargs="*",
        help="Optional example names or paths to run instead of git changed-path detection.",
    )
    argument_parser.add_argument(
        "--base",
        default="origin/main",
        help="Base ref for changed-path detection when no selections are provided.",
    )
    argument_parser.add_argument(
        "--runner",
        default="ctest",
        help="Runner executable to invoke for selected examples.",
    )
    argument_parser.add_argument(
        "--ctest-preset",
        default="dev",
        help="CTest preset passed to the runner.",
    )
    argument_parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print selected runner commands instead of executing them.",
    )
    return argument_parser


def normalize_path(path: str) -> str:
    return path.strip().replace("\\", "/")


def _manifest_path(root: Path) -> Path:
    return root / "examples" / "example_manifest.yaml"


def _load_manifest(root: Path) -> dict[str, Any]:
    if yaml is None:
        raise ManifestError("PyYAML is required to read examples/example_manifest.yaml")
    path = _manifest_path(root)
    try:
        loaded = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    except OSError as error:
        raise ManifestError(f"could not read {path}: {error}") from error
    except Exception as error:
        raise ManifestError(f"could not parse {path}: {error}") from error
    if not isinstance(loaded, dict):
        raise ManifestError(f"{path} must contain a mapping")
    return loaded


def _records(manifest: dict[str, Any], key: str) -> list[dict[str, Any]]:
    records = manifest.get(key, [])
    if records is None:
        return []
    if not isinstance(records, list):
        raise ManifestError(f"examples/example_manifest.yaml field {key!r} must be a list")
    return [record for record in records if isinstance(record, dict)]


def _unique_aliases(*aliases: str | None) -> tuple[str, ...]:
    seen: set[str] = set()
    result: list[str] = []
    for alias in aliases:
        if not alias:
            continue
        normalized = normalize_path(alias)
        if normalized and normalized not in seen:
            result.append(normalized)
            seen.add(normalized)
    return tuple(result)


def manifest_examples(root: Path | None = None) -> tuple[Example, ...]:
    """Return local example validation targets from examples/example_manifest.yaml."""
    root = root or repo_root()
    manifest = _load_manifest(root)
    examples: list[Example] = []

    for record in _records(manifest, "examples"):
        if record.get("status") != "ported":
            continue
        target_path = record.get("cpp_file")
        if not isinstance(target_path, str) or not target_path:
            continue
        if not (root / target_path).is_file():
            continue
        name_value = record.get("name")
        name = name_value if isinstance(name_value, str) and name_value else Path(target_path).stem
        upstream_path = record.get("upstream_file")
        if not isinstance(upstream_path, str):
            upstream_path = None
        validation = record.get("validation")
        if not isinstance(validation, dict):
            validation = {}
        manifest_aliases = record.get("aliases")
        aliases_from_manifest = manifest_aliases if isinstance(manifest_aliases, list) else []
        aliases = _unique_aliases(
            name,
            Path(target_path).name,
            target_path,
            upstream_path,
            *(alias for alias in aliases_from_manifest if isinstance(alias, str)),
        )
        visual_required = validation.get("visual") == "required"
        examples.append(
            Example(
                name=name,
                target_path=normalize_path(target_path),
                ctest_name=f"cppqtgraph.examples.{name}",
                aliases=aliases,
                visual_required=visual_required,
                visual_ctest_name=(
                    "P3.13.visual.SimplePlot"
                    if name == "SimplePlot" and visual_required
                    else None
                ),
            )
        )

    return tuple(examples)


def known_aliases(root: Path | None = None) -> dict[str, Example]:
    aliases: dict[str, Example] = {}
    for example in manifest_examples(root):
        for alias in example.aliases:
            aliases[normalize_path(alias)] = example
    return aliases


def examples_from_selections(
    selections: list[str], argument_parser: argparse.ArgumentParser, root: Path | None = None
) -> list[Example]:
    aliases = known_aliases(root)
    selected: list[Example] = []
    seen: set[str] = set()
    for selection in selections:
        example = aliases.get(normalize_path(selection))
        if example is None:
            argument_parser.exit(2, f"unknown example selection: {selection}\n")
        if example.name not in seen:
            selected.append(example)
            seen.add(example.name)
    return selected


def git_changed_paths(args: list[str], root: Path) -> list[str]:
    result = subprocess.run(
        ["git", *args],
        cwd=root,
        env=os.environ.copy(),
        text=True,
        capture_output=True,
    )
    if result.returncode != 0:
        if result.stdout:
            sys.stdout.write(result.stdout)
        if result.stderr:
            sys.stderr.write(result.stderr)
        raise SystemExit(result.returncode)
    return [normalize_path(line) for line in result.stdout.splitlines() if line.strip()]


def changed_paths(base: str, root: Path) -> list[str]:
    paths: list[str] = []
    seen: set[str] = set()
    for args in (
        ["diff", "--name-only", f"{base}...HEAD"],
        ["diff", "--name-only", "HEAD"],
        ["ls-files", "--others", "--exclude-standard", "--", "examples/"],
    ):
        for path in git_changed_paths(args, root):
            if path not in seen:
                paths.append(path)
                seen.add(path)
    return paths


def examples_from_changed_paths(paths: list[str], root: Path | None = None) -> list[Example]:
    changed = set(paths)
    selected: list[Example] = []
    for example in manifest_examples(root):
        if example.target_path in changed:
            selected.append(example)
    return selected


def runner_command(example: Example, runner: str, ctest_preset: str) -> list[str]:
    ctest_name = example.ctest_name
    if ctest_preset == "visual" and example.visual_required and example.visual_ctest_name:
        ctest_name = example.visual_ctest_name
    return [
        runner,
        "--preset",
        ctest_preset,
        "-R",
        f"^{re.escape(ctest_name)}$",
        "--output-on-failure",
    ]


def run_examples(examples: list[Example], runner: str, ctest_preset: str, root: Path, dry_run: bool) -> int:
    if not examples:
        print("No changed local examples.")
        return 0

    for example in examples:
        command = runner_command(example, runner, ctest_preset)
        if dry_run:
            print(shlex.join(command))
            continue
        env = os.environ.copy()
        env["QT_QPA_PLATFORM"] = "offscreen"
        result = subprocess.run(command, cwd=root, env=env)
        if result.returncode != 0:
            return result.returncode
    return 0


def main(argv: list[str] | None = None) -> int:
    argument_parser = parser()
    args = argument_parser.parse_args(argv)
    root = repo_root()

    try:
        if args.selections:
            selected = examples_from_selections(args.selections, argument_parser, root)
        else:
            selected = examples_from_changed_paths(changed_paths(args.base, root), root)
    except ManifestError as error:
        argument_parser.exit(2, f"example manifest failed: {error}\n")

    return run_examples(selected, args.runner, args.ctest_preset, root, args.dry_run)


if __name__ == "__main__":
    raise SystemExit(main())
