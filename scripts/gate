#!/usr/bin/env python3
"""Run local PGBOOT validation gates."""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import signal
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from types import SimpleNamespace
from typing import Any

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

try:
    from scripts.factory.workflow_config import (  # type: ignore[import-not-found]  # noqa: E402
        CommandResult,
        ConfigError,
        _subprocess_env,
        load_workflow_with_context,
    )
except ModuleNotFoundError:  # Product checkout fallback; Factory is not vendored here.
    try:
        import yaml
    except Exception:  # pragma: no cover - reported through ConfigError at runtime
        yaml = None

    class ConfigError(ValueError):
        pass

    @dataclass(frozen=True)
    class CommandResult:
        args: list[str] | str
        returncode: int
        stdout: str
        stderr: str

    @dataclass(frozen=True)
    class LoadedWorkflow:
        config: Any
        path: Path
        repo_root: Path

    def _namespace(value: Any) -> Any:
        if isinstance(value, dict):
            return SimpleNamespace(**{str(key): _namespace(item) for key, item in value.items()})
        if isinstance(value, list):
            return [_namespace(item) for item in value]
        return value

    def _section(data: dict[str, Any], name: str) -> dict[str, Any]:
        value = data.get(name, {})
        if value is None:
            return {}
        if not isinstance(value, dict):
            raise ConfigError(f"{name} must be a mapping")
        return value

    def _split_front_matter(text: str) -> str:
        if not text.startswith("---\n"):
            raise ConfigError("WORKFLOW.md must start with YAML front matter")
        try:
            _prefix, front_matter, _body = text.split("---", 2)
        except ValueError as error:
            raise ConfigError("WORKFLOW.md front matter is not closed") from error
        return front_matter.strip()

    def _parse_workflow_text(text: str) -> Any:
        if yaml is None:
            raise ConfigError("PyYAML is required to parse WORKFLOW.md")
        loaded = yaml.safe_load(_split_front_matter(text)) or {}
        if not isinstance(loaded, dict):
            raise ConfigError("WORKFLOW.md front matter must be a mapping")

        validation = _section(loaded, "validation")
        commands = validation.get("commands", [])
        if commands is None:
            commands = []
        if not isinstance(commands, list) or not all(isinstance(command, str) for command in commands):
            raise ConfigError("validation.commands must be a list of shell command strings")
        validation.setdefault("commands", commands)
        validation.setdefault("diff_check", True)
        loaded["validation"] = validation

        autoreview = _section(loaded, "autoreview")
        autoreview.setdefault("base", "origin/main")
        loaded["autoreview"] = autoreview
        return _namespace(loaded)

    def load_workflow_with_context(path: str | Path = "WORKFLOW.md") -> LoadedWorkflow:
        workflow_path = Path(path).resolve()
        return LoadedWorkflow(
            config=_parse_workflow_text(workflow_path.read_text(encoding="utf-8")),
            path=workflow_path,
            repo_root=workflow_path.parent,
        )

    def _subprocess_env() -> dict[str, str]:
        return os.environ.copy()


DEFAULT_REPORTS_DIR = ".factory/logs/gates"

CMAKE_VALIDATION_COMMANDS = [
    "cmake --preset dev",
    "cmake --build --preset dev --parallel",
    "ctest --preset dev --output-on-failure",
]


def _load_example_registry() -> Any:
    script = REPO_ROOT / "scripts" / "run_changed_examples"
    loader = importlib.machinery.SourceFileLoader("pgcpp_run_changed_examples_registry", str(script))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise ValueError("could not load example manifest registry")
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


def visual_examples() -> dict[str, Any]:
    """Return visual-gated examples from the shared manifest registry."""
    registry = _load_example_registry()
    return {
        example.name: example
        for example in registry.manifest_examples(REPO_ROOT)
        if example.visual_required
    }


def visual_gate_commands(example: str) -> list[str]:
    """Return focused visual oracle validation commands for an example."""
    targets = visual_examples()
    selected = targets.get(example)
    if selected is None:
        known = ", ".join(sorted(targets)) or "(none)"
        raise ValueError(f"unsupported visual gate target: {example}; known targets: {known}")
    return [
        "cmake --preset visual",
        "cmake --build --preset visual --target pyqtgraph_cpp_visual_render_example --parallel",
        f"ctest --preset visual -R '^P1\\.08\\.visual\\.{re.escape(selected.name)}$' --output-on-failure",
    ]


def validate_visual_target(parser: argparse.ArgumentParser, mode: str, target: str | None) -> None:
    """Validate the optional visual example argument before running commands."""
    if mode == "visual":
        if target is None:
            parser.error("visual mode requires an example name, e.g. SimplePlot")
        if not target.replace("_", "").isalnum():
            parser.error("visual example name may only contain letters, numbers, and underscores")
    elif target is not None:
        parser.error(f"{mode} mode does not accept an example name")


def diff_check_commands(base: str) -> list[str]:
    """Return local and branch diff checks for pre-PR validation."""
    return [
        "git diff --check",
        "git diff --cached --check",
        f"git diff --check {base}...HEAD",
    ]


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Run configured repository validation gates.")
    parser.add_argument("mode", choices=["focus", "commit", "merge", "visual"])
    parser.add_argument("target", nargs="?", help="example name for visual gates, e.g. SimplePlot")
    parser.add_argument("--workflow", default="WORKFLOW.md", help="workflow file to load")
    parser.add_argument(
        "--base",
        help="base ref for branch diff checks; defaults to workflow autoreview.base",
    )
    parser.add_argument("--reports-dir", default=DEFAULT_REPORTS_DIR, help="directory for gate reports")
    parser.add_argument("--timeout", type=int, default=1800, help="seconds to allow each gate command")
    parser.add_argument("--dry-run", action="store_true", help="print planned commands without running them")
    return parser


def command_plan(
    mode: str,
    validation_commands: list[str],
    diff_check: bool,
    base: str,
    target: str | None = None,
) -> list[str]:
    if mode == "focus":
        return list(validation_commands)
    if mode == "commit":
        commands = diff_check_commands(base) if diff_check else []
        return [*commands, *validation_commands, *CMAKE_VALIDATION_COMMANDS]
    if mode == "merge":
        return command_plan("commit", validation_commands, diff_check, base)
    if mode == "visual":
        if target is None:
            raise ValueError("visual mode requires an example name")
        return visual_gate_commands(target)
    raise ValueError(f"unsupported gate mode: {mode}")


def write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")


def timeout_output(value: str | bytes | None) -> str:
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return value


def run_gate_command(command: str, *, cwd: Path, timeout: int) -> CommandResult:
    process = subprocess.Popen(
        command,
        cwd=str(cwd),
        env=_subprocess_env(),
        shell=True,
        start_new_session=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    try:
        stdout, stderr = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired as error:
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            stdout, stderr = process.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            stdout, stderr = process.communicate()
        raise subprocess.TimeoutExpired(command, timeout, output=stdout, stderr=stderr) from error
    return CommandResult(args=command, returncode=process.returncode, stdout=stdout, stderr=stderr)


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    validate_visual_target(parser, args.mode, args.target)

    try:
        workflow = load_workflow_with_context(args.workflow)
    except (ConfigError, OSError) as error:
        print(f"gate configuration failed: {error}", file=sys.stderr)
        return 2

    base = args.base or workflow.config.autoreview.base
    try:
        commands = command_plan(
            args.mode,
            workflow.config.validation.commands,
            workflow.config.validation.diff_check,
            base,
            target=args.target,
        )
    except ValueError as error:
        print(f"gate configuration failed: {error}", file=sys.stderr)
        return 2

    if args.dry_run:
        for command in commands:
            print(command)
        return 0

    reports_dir = Path(args.reports_dir)
    if not reports_dir.is_absolute():
        reports_dir = workflow.repo_root / reports_dir
    reports_dir.mkdir(parents=True, exist_ok=True)

    summary: dict[str, object] = {
        "mode": args.mode,
        "workflow": str(workflow.path),
        "status": "passed",
        "commands": [],
    }
    if args.target is not None:
        summary["target"] = args.target

    for index, command in enumerate(commands, start=1):
        print(f"[{args.mode}] {command}")
        command_summary = {
            "index": index,
            "command": command,
            "returncode": 124,
            "log": f"{args.mode}-{index}.log",
        }
        log_path = reports_dir / command_summary["log"]
        try:
            result = run_gate_command(command, cwd=workflow.repo_root, timeout=args.timeout)
        except subprocess.TimeoutExpired as error:
            summary["commands"].append(command_summary)  # type: ignore[index]
            summary["status"] = "failed"
            summary["failed_command"] = command
            summary["timeout_seconds"] = args.timeout
            summary["finished_at"] = time.time()
            write_text(
                log_path,
                f"$ {command}\n\n[timeout]\ngate command timed out after {args.timeout} seconds\n"
                f"[stdout]\n{timeout_output(error.output)}\n[stderr]\n{timeout_output(error.stderr)}",
            )
            write_text(reports_dir / f"{args.mode}-summary.json", json.dumps(summary, indent=2, sort_keys=True) + "\n")
            print(f"gate {args.mode} timed out after {args.timeout} seconds: {command}", file=sys.stderr)
            return 124

        command_summary["returncode"] = result.returncode
        summary["commands"].append(command_summary)  # type: ignore[index]
        write_text(
            log_path,
            f"$ {command}\n\n[stdout]\n{result.stdout}\n[stderr]\n{result.stderr}",
        )
        if result.returncode != 0:
            summary["status"] = "failed"
            summary["failed_command"] = command
            summary["finished_at"] = time.time()
            write_text(reports_dir / f"{args.mode}-summary.json", json.dumps(summary, indent=2, sort_keys=True) + "\n")
            print(f"gate {args.mode} failed ({result.returncode}): {command}", file=sys.stderr)
            return result.returncode

    summary["finished_at"] = time.time()
    write_text(reports_dir / f"{args.mode}-summary.json", json.dumps(summary, indent=2, sort_keys=True) + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
