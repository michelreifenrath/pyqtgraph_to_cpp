#!/usr/bin/env python3
"""Audit source files for required license and attribution notes."""

from __future__ import annotations

import argparse
import os
import re
import stat
import sys
from pathlib import Path

PINNED_REF = "pyqtgraph-0.14.0"
PINNED_COMMIT = "a20028b98294b9cc8770f2015a92eb342224b788"
AUDIT_DIRS = (
    Path("include/pyqtgraph"),
    Path("src/pyqtgraph"),
    Path("examples"),
    Path("tests"),
    Path("benchmarks"),
)
REQUIRED_NOTE_DIRS = (Path("include/pyqtgraph"), Path("src/pyqtgraph"))
SOURCE_SUFFIXES = {".c", ".cc", ".cpp", ".cxx", ".h", ".hh", ".hpp", ".hxx", ".py"}


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="audit only; do not write files")
    parser.add_argument("--root", default=None, help="repository root to audit")
    return parser.parse_args(argv)


def repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def relpath(path: Path, root: Path) -> str:
    return path.relative_to(root).as_posix()


def is_under(path: Path, prefix: Path) -> bool:
    try:
        path.relative_to(prefix)
        return True
    except ValueError:
        return False


def is_source_file(path: Path, audit_dir: Path) -> bool:
    if path.name == ".gitkeep" or not path.is_file():
        return False
    if path.suffix in SOURCE_SUFFIXES:
        return True
    if path.suffix == "" and is_under(path, audit_dir):
        try:
            return bool(path.stat().st_mode & (stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH))
        except OSError:
            return False
    return False


PYQTGRAPH_NOTE_RE = re.compile(
    r"(?:Source note:\s*)?(?:translated|adapted)\s+from\s+PyQtGraph\b",
    re.IGNORECASE,
)


def has_pyqtgraph_source_note(text: str) -> bool:
    return bool(PYQTGRAPH_NOTE_RE.search(text))


def missing_pyqtgraph_fields(text: str) -> list[str]:
    missing: list[str] = []
    note_suffixes: list[str] = []
    for line in text.splitlines():
        if "pyqtgraph" not in line.lower():
            continue
        match = PYQTGRAPH_NOTE_RE.search(line)
        if not match:
            continue
        suffix = re.sub(r"\s*\*/\s*$", "", line[match.end() :]).strip()
        note_suffixes.append(suffix)
    has_upstream_path = any(
        any(token in suffix for token in ("/", ".py", ".cpp", ".h"))
        for suffix in note_suffixes
    )
    if not has_upstream_path:
        missing.append("upstream path")
    if f"PyQtGraph ref: {PINNED_REF}" not in text:
        missing.append("PyQtGraph ref")
    if f"Pinned commit: {PINNED_COMMIT}" not in text:
        missing.append("pinned commit")
    if "THIRD_PARTY_NOTICES.md" not in text or "License: MIT" not in text:
        missing.append("license notice pointer")
    return missing


def missing_generated_fields(text: str) -> list[str]:
    missing: list[str] = []
    if "Generated by" not in text:
        return missing
    if "Inputs:" not in text:
        missing.append("generation inputs")
    if "Do not edit manually" not in text:
        missing.append("manual edit notice")
    return missing


def accepted_note(text: str) -> bool:
    if has_pyqtgraph_source_note(text) and not missing_pyqtgraph_fields(text):
        return True
    if "Generated by" in text and not missing_generated_fields(text):
        return True
    if "Original implementation; no PyQtGraph source translation" in text:
        return True
    return False


def attribution_header(text: str) -> str:
    header: list[str] = []
    in_block_comment = False
    in_docstring: str | None = None
    for line in text.splitlines()[:80]:
        stripped = line.strip()
        if in_block_comment:
            header.append(line)
            if "*/" in stripped:
                in_block_comment = False
            continue
        if in_docstring:
            header.append(line)
            if in_docstring in stripped:
                in_docstring = None
            continue
        if not stripped or stripped.startswith(("#", "//", "*")):
            header.append(line)
            continue
        if stripped.startswith("/*"):
            header.append(line)
            if "*/" not in stripped[2:]:
                in_block_comment = True
            continue
        docstring_marker = next((marker for marker in ("'''", '\"\"\"') if stripped.startswith(marker)), None)
        if docstring_marker:
            header.append(line)
            if stripped.count(docstring_marker) < 2:
                in_docstring = docstring_marker
            continue
        break
    return "\n".join(header)


def audit_file(path: Path, root: Path, require_note: bool) -> list[str]:
    rel = relpath(path, root)
    try:
        text = path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        return [f"{rel}: not UTF-8 text"]

    header = attribution_header(text)
    errors: list[str] = []
    if has_pyqtgraph_source_note(header):
        errors.extend(f"{rel}: missing {field}" for field in missing_pyqtgraph_fields(header))
    if "Generated by" in header:
        errors.extend(f"{rel}: missing {field}" for field in missing_generated_fields(header))
    if require_note and not accepted_note(header):
        errors.append(f"{rel}: missing source attribution note")
    return errors


def audit(root: Path) -> list[str]:
    errors: list[str] = []
    root = root.resolve()
    required_roots = tuple((root / entry).resolve() for entry in REQUIRED_NOTE_DIRS)

    for audit_rel in AUDIT_DIRS:
        audit_dir = root / audit_rel
        if not audit_dir.exists():
            continue
        for path in sorted(audit_dir.rglob("*")):
            if not is_source_file(path, audit_dir):
                continue
            resolved = path.resolve()
            require_note = any(is_under(resolved, required_root) for required_root in required_roots)
            errors.extend(audit_file(resolved, root, require_note))
    return errors


def main(argv: list[str] | None = None) -> int:
    args = parse_args(sys.argv[1:] if argv is None else argv)
    root = Path(args.root).resolve() if args.root else repo_root()
    errors = audit(root)
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 1
    print("Attribution audit passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
